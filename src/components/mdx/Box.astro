---
/** Rounded tinted panel inside the content column. */
interface Props { bg?: string; image?: string; text?: string; accent?: string; pad?: string; mt?: number; mb?: number; mx?: string; radius?: string }
const { bg, image, text, accent, pad, mt, mb, mx, radius } = Astro.props;
const style = [
  `--box-bg: ${bg ?? 'transparent'}`,
  `--box-image: ${image ? `url(${image})` : 'none'}`,
  text && `--text: ${text}`,
  accent && `--accent: ${accent}`,
  `--box-pad: ${pad ?? '1.5rem 2rem'}`,
  mt !== undefined && `margin-top: ${mt}px`,
  mb !== undefined && `margin-bottom: ${mb}px`,
  mx && `margin-left: ${mx.split(' ')[0]}; margin-right: ${mx.split(' ')[1]}`,
  radius && `border-radius: ${radius}`,
].filter(Boolean).join('; ');
---
<div class="box" style={style} data-reveal><slot /></div>

<style>
  .box {
    margin-block: 0;
    padding: var(--box-pad);
    border-radius: var(--radius);
    background: var(--box-bg) var(--box-image) center / cover;
    color: var(--text);
  }
  .box > :global(:first-child) { margin-top: 0; }
  .box > :global(:last-child) { margin-bottom: 0; }
</style>
