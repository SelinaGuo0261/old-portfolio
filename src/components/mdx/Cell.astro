---
interface Props { bg?: string }
const { bg } = Astro.props;
---
<div class:list={['cell', { 'cell--panel': bg }]} style={bg ? `background: ${bg}` : undefined}><slot /></div>

<style>
  .cell { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .cell > :global(*) { max-width: 100%; }
  .cell > :global(p), .cell > :global(.fit) { align-self: stretch; }
  .cell--panel { padding: 20px; border-radius: var(--radius); }
</style>
