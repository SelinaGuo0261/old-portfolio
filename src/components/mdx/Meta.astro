---
interface Props { label: string; color?: string }
const { label, color } = Astro.props;
---
<div class="meta">
  <div class="meta__label" style={color ? `color: ${color}` : undefined}>{label} -</div>
  <div class="meta__value"><slot /></div>
</div>

<style>
  .meta { padding-inline: 10px; }
  .meta__label {
    margin: 10px 0;
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
  }
  .meta__value { margin: 10px 0; font-size: 14px; font-weight: 300; line-height: 1.6; }
  .meta__value :global(p) { margin: 0; }
  @media (min-width: 1280px) { .meta__label { font-size: 20px; line-height: 22px; } }
  @media (min-width: 1440px) {
    .meta__label { font-size: 22px; line-height: 28px; }
    .meta__value { font-size: 17px; }
  }
</style>
