---
/** Large centred statement (Fivo Sans Modern, 40px at desktop). */
import { typoStyle, type TypoProps } from './typo';
const style = typoStyle(Astro.props as TypoProps);
---
<p class:list={['lead', { 'text--sized': (Astro.props as TypoProps).size }]} style={style}><slot /></p>

<style>
  .lead {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }
  @media (min-width: 1280px) { .lead { font-size: 36px; } }
  @media (min-width: 1440px) { .lead { font-size: 40px; } }
  @media (max-width: 479px)  { .lead { font-size: 24px; line-height: 36px; } }
  .text--sized { font-size: min(calc(var(--fs) * 1px), calc(var(--fs) / 1440 * 100vw + 4px)); }
</style>
