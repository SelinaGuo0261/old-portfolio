---
/**
 * Full-width band with its own background. `dark` / `light` flip the
 * text colour when the band contrasts with the page background.
 */
interface Props { bg?: string; image?: string; text?: string; accent?: string; pad?: string; mt?: number; mb?: number; mx?: string; radius?: string }
const { bg, image, text, accent, pad, mt, mb } = Astro.props;
const style = [
  `--band-bg: ${bg ?? 'transparent'}`,
  `--band-image: ${image ? `url(${image})` : 'none'}`,
  text && `--text: ${text}`,
  accent && `--accent: ${accent}`,
  `--band-pad: ${pad ?? '3rem 0'}`,
  mt !== undefined && `margin-top: ${mt}px`,
  mb !== undefined && `margin-bottom: ${mb}px`,
].filter(Boolean).join('; ');
---
<section class="band" style={style}>
  <div class="band__inner"><slot /></div>
</section>

<style>
  .band {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    margin-block: 0;
    background: var(--band-bg) var(--band-image) center / cover;
    color: var(--text);
  }
  .band__inner { margin-inline: var(--gutter); padding: var(--band-pad); padding-inline: 0; }
</style>
