---
/** Row of project facts (Timeline / Role / Team / Tools). */
---
<div class="meta-grid" data-reveal><slot /></div>

<style>
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 60px 0;
  }
  @media (max-width: 767px) { .meta-grid { grid-template-columns: 1fr 1fr; } }
</style>
