---
/** Equal-width grid of <Cell>s (Webflow "quick stack": 20px gaps and padding). */
interface Props { cols?: number; bg?: string }
const { cols = 2, bg } = Astro.props;
---
<div class="grid" style={`--cols: ${cols};${bg ? ` background: ${bg}` : ''}`} data-reveal>
  <slot />
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 20px;
    padding: 20px;
  }
  @media (max-width: 991px) { .grid { grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr)); } }
  @media (max-width: 479px) { .grid { grid-template-columns: 1fr; } }
</style>
