---
/**
 * Section marker ("📱 Main Features"). Its `id` is the anchor used by the
 * dot navigation on the side of project pages.
 */
interface Props { id: string }
const { id } = Astro.props;
---
<h2 class="divider" id={id} data-section-anchor data-reveal><span><slot /></span></h2>

<style>
  .divider {
    margin: 0;
    padding-block: 40px;
    scroll-margin-top: var(--nav-h);
  }
  .divider span {
    display: inline-flex;
    justify-content: center;
    min-width: 40%;
    padding: 0 2rem;
    border: 4px solid currentColor;
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 90px;
    color: var(--text);
  }
  @media (min-width: 1280px) { .divider span { font-size: 2.5rem; line-height: 100px; } }
  @media (max-width: 479px)  { .divider span { width: 100%; font-size: 1.5rem; line-height: 2.5; } }
</style>
