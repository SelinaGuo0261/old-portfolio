---
/**
 * Section pill ("📱 Main Features"). Its `id` is the anchor used by the
 * side navigation on project pages.
 */
interface Props { id: string; color?: string; wide?: boolean }
const { id, color, wide } = Astro.props;
---
<h2 class:list={['divider', { 'divider--wide': wide }]} id={id} data-section-anchor data-reveal style={color ? `--divider: ${color}` : undefined}><span><slot /></span></h2>

<style>
  .divider { margin: 0; padding-block: 40px; scroll-margin-top: var(--nav-h); }
  .divider span {
    display: flex;
    justify-content: center;
    width: 40%;
    border: 4px solid var(--divider, var(--divider-border, #000));
    border-radius: 100px;
    color: var(--divider, var(--divider-text, #333));
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 90px;
    white-space: nowrap;
  }
  .divider--wide span { width: 90%; }
  @media (min-width: 1280px) { .divider span { font-size: 40px; line-height: 100px; } }
  @media (min-width: 1440px) { .divider span { font-size: 44px; line-height: 120px; } }
  @media (max-width: 479px)  { .divider span { width: 100%; font-size: 24px; line-height: 40px; } }
</style>
