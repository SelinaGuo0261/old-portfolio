---
interface Props { id: string; title?: string; mt?: number; mb?: number }
const { id, title = 'YouTube video', mt, mb } = Astro.props;
const style = [mt !== undefined && `margin-top: ${mt}px`, mb !== undefined && `margin-bottom: ${mb}px`].filter(Boolean).join('; ');
---
<div class="video" style={style || undefined} data-reveal>
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}?rel=0&controls=1&autoplay=0&mute=0`}
    title={title}
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</div>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; margin: 0; overflow: hidden; }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
