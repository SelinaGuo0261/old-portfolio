---
/**
 * Spacing wrapper: keeps the margins/padding a block had on the old site
 * (px; `padx` is side padding as a share of the width, e.g. "14%").
 */
interface Props { mt?: number; mb?: number; pt?: number; pb?: number; padx?: string }
const { mt, mb, pt, pb, padx } = Astro.props;
const style = [
  mt !== undefined && `margin-top: ${mt}px`,
  mb !== undefined && `margin-bottom: ${mb}px`,
  pt !== undefined && `padding-top: ${pt}px`,
  pb !== undefined && `padding-bottom: ${pb}px`,
  padx && `--padx: ${padx}`,
].filter(Boolean).join('; ');
---
<div class="block" style={style || undefined}><slot /></div>

<style>
  .block { padding-inline: var(--padx, 0); }
  @media (max-width: 479px) { .block { padding-inline: 0; } }
</style>
