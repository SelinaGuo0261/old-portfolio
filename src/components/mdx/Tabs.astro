---
/** Tabbed panels: wrap several <Tab label="…"> in <Tabs>. */
---
<div class="tabs" data-tabs data-reveal>
  <div class="tabs__list" role="tablist"></div>
  <div class="tabs__panels"><slot /></div>
</div>

<style>
  .tabs { margin-block: 2rem; padding: 1.5rem; border-radius: var(--radius); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .tabs__list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .tabs :global(.tabs__button) {
    padding: 0.5em 1.2em;
    border: 2px solid var(--accent);
    border-radius: 100px;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .tabs :global(.tabs__button[aria-selected='true']) { background: var(--accent); color: var(--white); }
</style>
