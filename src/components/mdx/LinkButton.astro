---
/** Pill link with the colour-fill + magnetic hover from the old site. */
interface Props { href: string }
const { href } = Astro.props;
const external = /^https?:/.test(href);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = href.startsWith('/') ? base + href : href;
---
<p class="link-button-wrap" data-reveal>
  <a class="link-button" href={url} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}
     data-hover="fill" data-magnetic="20">
    <span class="link-button__text" data-magnetic-inner><slot /></span>
    <span class="link-button__fill" data-hover-target></span>
  </a>
</p>

<style>
  .link-button-wrap { text-align: center; margin-block: 2.5rem; }
  .link-button {
    position: relative;
    display: inline-block;
    overflow: hidden;
    padding: 1em 2.4em;
    border: 2px solid var(--accent);
    border-radius: 100px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    isolation: isolate;
  }
  .link-button__fill { position: absolute; inset: auto 0 0; height: 0; background: var(--accent); z-index: -1; }
  .link-button__text { display: inline-block; }
</style>
