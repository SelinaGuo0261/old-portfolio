---
/**
 * Round "View Prototype" link (white circle, colour rises on hover).
 * `offset` pushes it right by that many px at desktop width; `center` centres it.
 */
interface Props { href: string; offset?: number; center?: boolean }
const { href, offset, center } = Astro.props;
const external = /^https?:/.test(href);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = href.startsWith('/') ? base + href : href;
---
<a class:list={['link-proto', { 'link-proto--center': center }]} href={url} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}
   style={offset ? `--offset: ${offset}` : undefined} data-hover="fill" data-magnetic="50">
  <span class="link-proto__text" data-magnetic-inner><slot /></span>
  <span class="link-proto__fill" data-hover-target></span>
</a>

<style>
  .link-proto {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 100px;
    margin-left: calc(var(--offset, 0) * 0.8px);
    border-radius: 100%;
    background: #fff;
    overflow: hidden;
    text-decoration: none;
  }
  .link-proto__text {
    position: relative;
    z-index: 5;
    color: #333;
    text-align: center;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
  }
  .link-proto--center { margin-inline: auto !important; }
  .link-proto__fill { position: absolute; inset: auto 0 0; z-index: 1; height: 0; border-radius: 100%; background: var(--purple); }
  @media (min-width: 1280px) { .link-proto { width: 120px; height: 120px; margin-left: calc(var(--offset, 0) * 0.86px); } .link-proto__text { font-size: 18px; } }
  @media (min-width: 1440px) { .link-proto { width: 140px; height: 140px; margin-left: calc(var(--offset, 0) * 1px); } .link-proto__text { font-size: 20px; } }
  @media (max-width: 767px) { .link-proto { margin-left: 0; } }
</style>
