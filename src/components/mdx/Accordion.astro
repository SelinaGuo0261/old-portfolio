---
interface Props { title: string }
const { title } = Astro.props;
---
<div class="accordion" data-accordion data-reveal>
  <button class="accordion__toggle" type="button" data-accordion-toggle>
    <span>{title}</span>
    <svg data-accordion-icon viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path fill="currentColor" d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
    </svg>
  </button>
  <div class="accordion__panel" data-accordion-panel><slot /></div>
</div>

<style>
  .accordion { margin-block: 2rem; }
  .accordion__toggle {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.6em 1.4em;
    border: 2px solid var(--accent); border-radius: 100px;
    background: transparent; color: var(--text);
    font: inherit; font-weight: 500; cursor: pointer;
  }
  .accordion__panel :global(pre) { max-height: 40rem; overflow: auto; border-radius: var(--radius); padding: 1rem; font-size: 0.8rem; }
</style>
