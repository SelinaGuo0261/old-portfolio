---
/** Any other iframe (Figma prototype, etc.). */
interface Props { src: string; title?: string; ratio?: string }
const { src, title = 'Embedded content', ratio = '16 / 9' } = Astro.props;
---
<div class="embed" style={`aspect-ratio: ${ratio}`} data-reveal>
  <iframe src={src} title={title} loading="lazy" allowfullscreen></iframe>
</div>

<style>
  .embed { position: relative; margin-block: 2rem; }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
