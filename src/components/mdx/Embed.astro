---
/** Any other iframe (Figma prototype, etc.). */
interface Props { src: string; title?: string; ratio?: string; mt?: number; mb?: number }
const { src, title = 'Embedded content', ratio = '16 / 9', mt, mb } = Astro.props;
---
<div class="embed" style={`aspect-ratio: ${ratio};${mt !== undefined ? ` margin-top: ${mt}px;` : ''}${mb !== undefined ? ` margin-bottom: ${mb}px;` : ''}`} data-reveal>
  <iframe src={src} title={title} loading="lazy" allowfullscreen></iframe>
</div>

<style>
  .embed { position: relative; margin: 0; }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
