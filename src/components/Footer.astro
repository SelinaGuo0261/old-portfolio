---
/** Site footer — original Webflow markup/classes (styles/footer.css). */
import '@/styles/footer.css';
import { Image } from 'astro:assets';
import footerLogo from '@/assets/site/footer-logo.png';
import linkedin from '@/assets/site/linkedin.png';
import instagram from '@/assets/site/instagram.png';
import youtube from '@/assets/site/youtube.png';
import email from '@/assets/site/email.png';
import phone from '@/assets/site/phone.png';
import wechat from '@/assets/site/wechat.png';
import wechatQr from '@/assets/site/wechat-qr.jpg';
import { getProjects, type Project } from '@/lib/projects';
import { href, projectHref, isExternal } from '@/lib/url';
import { site } from '@/lib/site';

const listed = (p: Project) => p.data.footer && !!projectHref(p);
const professional = (await getProjects('professional')).filter(listed);
const caseStudies = (await getProjects('case-study')).filter(listed);

const social = [
  { label: 'LinkedIn', url: site.linkedin, icon: linkedin },
  { label: 'Instagram', url: site.instagram, icon: instagram },
  { label: 'YouTube', url: site.youtube, icon: youtube },
  { label: 'Email', url: `mailto:${site.email}`, icon: email },
  { label: 'Phone', url: `tel:${site.phone}`, icon: phone },
  { label: 'WeChat QR code', url: wechatQr.src, icon: wechat },
];
const year = new Date().getFullYear();

interface Props {
  /** Full footer (links + social) as on the home page, or only the copyright line. */
  full?: boolean;
}
const { full = false } = Astro.props;
const ext = (url?: string) => (isExternal(url) ? { target: '_blank', rel: 'noopener' } : {});
---

{full && (
<div class="footer">
  <div class="main-feature-wrapper">
    <div class="w-row">
      <div class="w-col w-col-4">
        <Image class="image-127" src={footerLogo} alt="Selina Guo" />
        <div class="footer-connect">
          {social.map((s) => (
            <a class="footer-link w-inline-block" href={s.url} aria-label={s.label} {...(s.url.startsWith('http') || s.url.endsWith('.jpg') ? { target: '_blank', rel: 'noopener' } : {})}>
              <Image src={s.icon} alt="" />
            </a>
          ))}
        </div>
      </div>
      <div class="w-col w-col-3">
        <div class="text-block-69 white">Professional Projects</div>
        {professional.map((p) => <a class="content footer" href={projectHref(p)} {...ext(projectHref(p))}>{p.data.title}</a>)}
      </div>
      <div class="w-col w-col-3">
        <div class="text-block-69 white">Case Studies</div>
        {caseStudies.map((p) => <a class="content footer" href={projectHref(p)} {...ext(projectHref(p))}>{p.data.title}</a>)}
      </div>
      <div class="w-col w-col-2">
        <div class="text-block-69 white">About Me</div>
        <a class="content footer" href={href('about')}>My story</a>
        <a class="content footer" href={href('experiment')}>Experimentations</a>
      </div>
    </div>
  </div>
</div>
)}
<footer class="rights-served">
  <div class="text-block-22">Copyright © 2020-{year} Xinyu Guo. All Rights Reserved</div>
</footer>
