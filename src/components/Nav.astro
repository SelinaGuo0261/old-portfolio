---
/** Navbar — original Webflow markup/classes (styles/nav.css). */
import '@/styles/nav.css';
import { Image } from 'astro:assets';
import logoLight from '@/assets/site/logo-light.png';
import logoDark from '@/assets/site/logo-dark.png';
import { href } from '@/lib/url';

interface Props {
  /** "overlay" floats over the dark home hero and turns light on scroll. */
  variant?: 'default' | 'overlay';
}
const { variant = 'default' } = Astro.props;
const overlay = variant === 'overlay';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';

const links = [
  { label: 'Professional', to: 'work', match: ['/work'] },
  { label: 'Case Study', to: 'projects', match: ['/projects'] },
  { label: 'Playground', to: 'experiment', match: ['/experiment'] },
  { label: 'About', to: 'about', match: ['/about'] },
];
const isCurrent = (match: string[]) => match.some((m) => path === m || path === `${m}/`);
---

<div class:list={['navbar-5', 'w-nav', { 'on-dark': overlay }]} data-collapse="medium" data-nav={variant} role="banner">
  <div class:list={['div-block-3', { 'on-dark': overlay }]}>
    {/* logo-light = white mark for dark backgrounds, logo-dark = black mark */}
    <a class:list={['brand', 'w-nav-brand', { 'w--current': path === '/' }]} href={href('/')} aria-label="Home">
      <Image class="logo-bright" src={overlay ? logoLight : logoDark} alt="" loading="eager" />
    </a>
    {overlay && (
      <a class="brand2 w-nav-brand w--current" href={href('/')} aria-label="Home" tabindex="-1">
        <Image class="logo-dark" src={logoDark} alt="" loading="eager" />
      </a>
    )}
    <nav class="nav-menu w-nav-menu" id="nav-menu">
      {links.map((l) => (
        <a class:list={['nav-link-13', 'w-nav-link', { 'on-dark': overlay, 'w--current': isCurrent(l.match) }]}
           href={href(l.to)} aria-current={isCurrent(l.match) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <button class="menu-button-4 w-nav-button nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="visually-hidden">Menu</span>
      <span class="nav__bar"></span><span class="nav__bar"></span><span class="nav__bar"></span>
    </button>
  </div>
</div>

<style is:global>
  /* Overlay navbar after scrolling past the hero (old "Navbar change colour"). */
  .navbar-5.on-dark.is-solid .nav-link-13.on-dark { color: #000; }
  .navbar-5.on-dark.is-solid .nav-link-13.on-dark.w--current { color: var(--brand-blue); }
  .navbar-5.on-dark.is-solid .brand { display: none; }
  .navbar-5.on-dark.is-solid .brand2 { display: block; position: static; }
  .navbar-5 { z-index: 1000; will-change: transform; }
  .logo-bright, .logo-dark { width: auto; }
  /* Inline-block left a baseline gap under the dark logo, so the solid
     navbar grew 5px taller than the transparent one. */
  .navbar-5 .logo-dark { display: block; }

  /* Menu button (Webflow drew it with an icon font). */
  .nav__toggle { background: none; border: 0; }
  .nav__bar { display: block; width: 24px; height: 2px; margin: 5px 0; background: #000; }
  .navbar-5.on-dark:not(.is-solid) .nav__bar { background: #fff; }

  @media screen and (max-width: 991px) {
    .navbar-5 .div-block-3 { display: flex; align-items: center; justify-content: space-between; }
    .navbar-5.is-open { overflow: visible; }
    .navbar-5.is-open .w-nav-menu {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      float: none;
      background: #f7f8fa;
      box-shadow: 0 8px 12px #0002;
    }
    .navbar-5.is-open .w-nav-link { display: block; color: #000; }
  }
</style>
