---
/** "Seattle, WA · live clock · Open to work" strip with wave animations. */
import { site } from '@/lib/site';
import wave from '@/assets/lottie/wave.json?url';
---
<div class="status" data-reveal="fade">
  <div class="status__wave" data-lottie={wave} data-lottie-loop data-lottie-fill></div>
  <div class="status__text">
    <span>{site.location}</span>
    <time class="status__clock" data-clock={site.timeZone}>&nbsp;</time>
    <span>Open to work</span>
  </div>
  <div class="status__wave status__wave--right" data-lottie={wave} data-lottie-loop data-lottie-fill></div>
</div>

<style>
  .status { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-block: 3rem 5rem; }
  .status__wave { height: 70px; overflow: hidden; }
  .status__wave--right { transform: scaleX(-1); }
  .status__text { display: flex; gap: 1.25rem; font-family: var(--font-display); font-size: 1.125rem; font-weight: 500; white-space: nowrap; }
  .status__clock { color: var(--brand-blue); font-variant-numeric: tabular-nums; min-width: 9ch; }
  @media (max-width: 767px) {
    .status { grid-template-columns: 1fr; }
    .status__wave { display: none; }
    .status__text { justify-content: center; flex-wrap: wrap; white-space: normal; }
  }
</style>
