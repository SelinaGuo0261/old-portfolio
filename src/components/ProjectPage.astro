---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { mdxComponents } from '@/components/mdx';
import { getProjects, type Project } from '@/lib/projects';
import { href, projectHref } from '@/lib/url';

interface Props { project: Project }
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// "Next" = the following project in the same section that has its own page.
const siblings = (await getProjects(data.category)).filter((p) => !p.data.listOnly && !p.data.externalUrl);
const i = siblings.findIndex((p) => p.id === project.id);
const next = siblings.length > 1 ? siblings[(i + 1) % siblings.length] : undefined;
const listPage = { professional: 'work', 'case-study': 'projects', playground: 'experiment' }[data.category];

const backLabel = data.category === 'professional' ? 'Back to Work List' : 'Back to Project List';
const endStyle = [
  `--end-line: ${data.ending.line}`,
  `--end-title: ${data.ending.title}`,
  `--end-gradient: ${data.ending.gradient}`,
  `--end-button: ${data.ending.button}`,
  `--end-button-text: ${data.ending.buttonText}`,
].join('; ');

const themeStyle = [
  `--page-bg: ${data.theme.background}`,
  `--text: ${data.theme.text}`,
  `--accent: ${data.theme.accent}`,
  data.theme.paragraphGap !== undefined && `--p-gap: ${data.theme.paragraphGap}px`,
].filter(Boolean).join('; ');
---

<BaseLayout title={data.title} description={data.summary} accent={data.theme.accent}>
  <article class="project" style={themeStyle} data-project={project.id}>
    {data.hero ? (
      <>
        <h1 class="visually-hidden">{data.title}</h1>
        <Image class="project__hero" src={data.hero} alt={data.title} widths={[800, 1440, 2400]} sizes="100vw" loading="eager" />
      </>
    ) : (
      <header class="project__header">
        <h1 class="project__title" data-split="words-slide-up">{data.title}</h1>
        {data.period && <p class="project__period">{data.period}</p>}
      </header>
    )}

    <div class="project__body prose">
      <Content components={mdxComponents} />
    </div>

    {data.ending.show !== 'none' && (
      <footer class:list={['project__end', { 'project__end--full': data.ending.show === 'full' }]} style={endStyle}>
        <div class="end-wrapper">
          <div class="thank-you w-row">
            <div class="w-col w-col-4"><div class="end"></div></div>
            <div class="w-col w-col-4"><div class="vision-center">Thanks for Reading</div></div>
            <div class="w-col w-col-4"><div class="end"></div></div>
          </div>
          {data.ending.show === 'full' && (
            <div class="button-bottom w-row">
              <div class="column-17 w-col w-col-6">
                <div class="btn" data-hover="spin">
                  <div class="btn-inside">
                    <div class="btn-background" data-hover-target></div>
                    <a class="btn-link" href={href(listPage)}><span class="btn-text">{backLabel}</span></a>
                  </div>
                </div>
              </div>
              <div class="column-18 w-col w-col-6">
                {next && (
                  <div class="btn" data-hover="spin">
                    <div class="btn-inside">
                      <div class="btn-background" data-hover-target></div>
                      <a class="btn-link" href={projectHref(next)}><span class="btn-text">See Next Work</span></a>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </footer>
    )}

    <nav class="section-nav" aria-label="Sections" data-section-nav></nav>
  </article>
</BaseLayout>

<script>
  import { initProjectPage } from '@/scripts/project';
  initProjectPage();
</script>

<style>
  .project {
    background: var(--page-bg);
    color: var(--text);
    overflow-x: clip;
  }
  .project__hero { width: 100%; height: auto; }
  .project__header { margin-inline: var(--gutter); padding-top: 6rem; text-align: center; }
  .project__title { font-family: var(--font-display); font-size: 3.5rem; font-weight: 700; line-height: 1.2; }
  .project__period { color: var(--accent); }
  .project__body { margin-inline: var(--gutter); }

  /* Closing row: same sizes as the old site's .bottom / .thank-you / .btn. */
  .project__end { position: relative; overflow: hidden; }
  .project__end--full { padding: 20px 0; }
  .end-wrapper { margin: 0 15%; padding: 40px 0; }
  .thank-you { display: flex; justify-content: center; align-items: center; }
  .end { height: 6px; border-radius: 20px; background: var(--end-line); }
  .vision-center {
    color: var(--end-title); text-align: center;
    font-family: Lexend, sans-serif; font-size: 20px; font-weight: 500; line-height: 26px;
  }
  .button-bottom { margin: 20px 0 100px; }
  .column-17, .column-18 { display: flex; align-items: center; }
  .column-17 { justify-content: flex-end; }
  .column-18 { justify-content: flex-start; }
  .btn, .btn-inside {
    position: relative; display: flex; justify-content: center; align-items: center;
    width: 220px; height: 60px; padding: 0; border: 0; border-radius: 100vw; background: #fff; overflow: hidden;
  }
  .btn-inside { overflow: visible; }
  .btn-background { min-width: 220px; min-height: 220px; background-image: var(--end-gradient); }
  .btn-link {
    position: absolute; inset: 12% 4%; display: flex; justify-content: center; align-items: center;
    border-radius: 100vw; background: var(--end-button); text-decoration: none;
  }
  .btn-text { color: var(--end-button-text); font-family: Lexend, sans-serif; font-size: 14px; font-weight: 400; line-height: 1.6; }
  @media (min-width: 1280px) {
    .project__end--full { padding-bottom: 40px; }
    .end-wrapper { padding: 50px 0; }
    .btn-text { font-size: 15px; }
  }
  @media (min-width: 1440px) {
    .end-wrapper { padding: 60px 0; }
    .vision-center { font-size: 22px; line-height: 28px; }
    .column-17, .column-18 { padding-inline: 20px; }
    .btn, .btn-inside { width: 240px; height: 70px; }
    .btn-background { min-width: 240px; min-height: 240px; }
    .btn-text { font-size: 18px; }
  }
  @media (min-width: 1920px) {
    .end-wrapper { padding: 80px 0; }
    .vision-center { font-size: 30px; line-height: 36px; }
    .btn, .btn-inside { width: 280px; height: 80px; }
    .btn-background { min-width: 280px; min-height: 280px; }
    .btn-text { font-size: 24px; line-height: 1.4; }
  }
  @media (max-width: 991px) { .end-wrapper { margin: 0 60px; } }
  @media (max-width: 479px) {
    .end-wrapper { margin: 0; padding-inline: 30px; }
    .vision-center { font-size: 16px; }
    .column-17, .column-18 { padding-block: 10px; }
  }

  .section-nav {
    position: fixed;
    left: 1.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    z-index: 50;
  }
  .section-nav :global(a) {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem; height: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 25%, transparent);
    font-size: 1.05rem;
    line-height: 1;
    text-decoration: none;
    transition: background 0.3s, transform 0.3s;
  }
  .section-nav :global(a.is-active) { background: var(--accent); transform: scale(1.15); }
  .section-nav :global(a .section-nav__label) {
    position: absolute; left: calc(100% + 10px); top: 50%; transform: translateY(-50%);
    white-space: nowrap; font-size: 0.8rem; padding: 0.25em 0.7em; border-radius: 4px;
    background: var(--accent); color: #fff; opacity: 0; pointer-events: none; transition: opacity 0.2s;
  }
  .section-nav :global(a:hover .section-nav__label) { opacity: 1; }
  @media (max-width: 1199px) { .section-nav { display: none; } }
</style>
