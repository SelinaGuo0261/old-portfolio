---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects, type Project } from '@/lib/projects';
import { projectHref, isExternal } from '@/lib/url';

const playground = await getProjects('playground');
const group = (g: NonNullable<Project['data']['group']>) => playground.filter((p) => p.data.group === g);

const creativity = group('creativity-captain');
const philosophy = group('philosophy-mastermind');
const compiler = group('compiler-conqueror');
const workshop = group('workshop-assistant');
const art = group('artistic-alchemist');

/** Grid footprint for an artwork from its proportions. */
function artSpan(p: Project): string {
  const { width, height } = p.data.cover;
  const r = width / height;
  if (r >= 2.6) return 'span-4';
  if (r >= 1.6) return 'span-3';
  if (r >= 1.15) return 'span-2';
  if (r <= 0.7) return 'tall';
  return '';
}
const linkProps = (p: Project) => {
  const url = projectHref(p);
  return url ? { href: url, target: isExternal(url) ? '_blank' : undefined, rel: isExternal(url) ? 'noopener' : undefined } : {};
};
---

<BaseLayout title="Playground" description="Experiments in industrial design, code, philosophy and art.">
  <div class="wrap">
    <p class="pg-intro" data-split="letters-fade-in">I also worked as a ......</p>

    <section>
      <h2 class="group-title" data-split="words-slide-up">Creativity Captain</h2>
      <div class="flip-grid">
        {creativity.map((p) => {
          const Tag = projectHref(p) ? 'a' : 'div';
          return (
            <Tag class="flip" data-hover="flip" data-reveal="grow" {...linkProps(p)}>
              <div class="flip__image" data-hover-push>
                <Image src={p.data.cover} alt="" widths={[400, 800]} sizes="(max-width: 767px) 100vw, 30vw" />
              </div>
              <div class="flip__content" data-hover-target>
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
                {projectHref(p) && <span class="flip__view">VIEW</span>}
              </div>
            </Tag>
          );
        })}
      </div>
    </section>

    <section>
      <h2 class="group-title" data-split="words-slide-up">Philosophy Mastermind</h2>
      <div class="strip" data-reveal="left">
        {philosophy.map((p) => {
          const Tag = projectHref(p) ? 'a' : 'div';
          return (
            <Tag class="strip__item" data-hover="reveal" {...linkProps(p)}>
              <Image src={p.data.cover} alt="" widths={[400, 800]} sizes="(max-width: 767px) 100vw, 25vw" />
              <span class="strip__text" data-hover-target>{p.data.title}</span>
            </Tag>
          );
        })}
      </div>
    </section>

    <section>
      <h2 class="group-title" data-split="words-slide-up">Compiler Conqueror</h2>
      <div class="code-grid">
        {compiler.map((p) => (
          <figure class="code-grid__item" data-reveal>
            <Image src={p.data.cover} alt="" widths={[600, 1100]} sizes="(max-width: 767px) 100vw, 45vw" />
            <figcaption>{p.data.title}</figcaption>
          </figure>
        ))}
        <p class="code-grid__more" data-reveal>And waiting for more...</p>
      </div>
    </section>

    {workshop.map((p) => (
      <section>
        <h2 class="group-title" data-split="words-slide-up">{p.data.title}</h2>
        <div class="workshop">
          {(p.data.gallery ?? [p.data.cover]).map((img) => (
            <Image src={img} alt="" widths={[400, 800]} sizes="(max-width: 767px) 100vw, 30vw" data-reveal="bottom" />
          ))}
        </div>
      </section>
    ))}

    <section>
      <h2 class="group-title" data-split="words-slide-up">Artistic Alchemist</h2>
      <div class="art-grid">
        {art.map((p) => (
          <figure class:list={['art', artSpan(p)]} data-reveal>
            <Image src={p.data.cover} alt={p.data.title} widths={[400, 800, 1400]} sizes="(max-width: 767px) 100vw, 50vw" />
            {p.data.disciplines && <span class="art__medium">{p.data.disciplines}</span>}
            <figcaption>
              <strong>{p.data.title}</strong>
              {p.data.summary !== p.data.disciplines && <span>{p.data.summary}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pg-intro { font-family: var(--font-display); font-size: 2rem; font-weight: 500; margin: 3rem 0 0; }

  .flip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .flip { position: relative; display: block; aspect-ratio: 325 / 280; overflow: hidden; perspective: 1000px; color: inherit; text-decoration: none; background: var(--white); }
  .flip__image { position: absolute; inset: 0; }
  .flip__image img { width: 100%; height: 100%; object-fit: cover; }
  .flip__content {
    position: absolute; inset: 0 50% 0 0;
    display: flex; flex-direction: column; justify-content: center; gap: 0.5rem;
    padding: 1.25rem; background: var(--white); transform-origin: left center;
  }
  .flip__content h3 { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.1; }
  .flip__content p { margin: 0; font-size: 0.9rem; line-height: 1.4; }
  .flip__view { margin-top: 0.5rem; font-weight: 700; color: var(--orange); }

  .strip { display: flex; height: 26rem; }
  .strip__item { position: relative; flex: 1; overflow: hidden; transition: flex 0.5s ease; color: var(--white); text-decoration: none; }
  .strip__item:hover { flex: 2.2; }
  .strip__item img { width: 100%; height: 100%; object-fit: cover; }
  .strip__text {
    position: absolute; inset: auto 0 0; padding: 1.25rem;
    background: linear-gradient(transparent, #000c);
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 700;
  }

  .code-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  .code-grid__item { margin: 0; }
  .code-grid__item img { width: 100%; height: auto; }
  .code-grid figcaption, .code-grid__more { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; margin: 0.5rem 0 0; }

  .workshop { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .workshop img { width: 100%; aspect-ratio: 1; object-fit: cover; }

  .art-grid { display: grid; grid-template-columns: repeat(5, 1fr); grid-auto-rows: 15rem; grid-auto-flow: dense; gap: 1.5rem; margin-bottom: 4rem; }
  .art { position: relative; margin: 0; overflow: hidden; color: var(--white); }
  .art.span-2 { grid-column: span 2; }
  .art.span-3 { grid-column: span 3; }
  .art.span-4 { grid-column: span 4; }
  .art.tall { grid-row: span 2; }
  .art img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .art:hover img { transform: scale(1.05); }
  .art__medium { position: absolute; top: 1rem; right: 1rem; display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; text-shadow: 0 1px 4px #0008; }
  .art__medium::before { content: ''; width: 0.9rem; height: 0.9rem; border: 2px solid currentColor; border-radius: 50%; }
  .art figcaption { position: absolute; inset: auto 0 0; padding: 1rem 1.25rem; background: linear-gradient(transparent, #0009); display: flex; flex-direction: column; }
  .art figcaption strong { font-family: var(--font-display); font-size: 1.25rem; }
  .art figcaption span { font-size: 0.9rem; }

  @media (max-width: 991px) {
    .flip-grid, .workshop { grid-template-columns: 1fr 1fr; }
    .art-grid { grid-template-columns: repeat(2, 1fr); }
    .art.span-3, .art.span-4 { grid-column: span 2; }
  }
  @media (max-width: 479px) {
    .flip-grid, .workshop, .code-grid { grid-template-columns: 1fr; }
    .strip { flex-direction: column; height: auto; }
    .strip__item { height: 12rem; }
  }
</style>
