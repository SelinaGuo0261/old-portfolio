---
/**
 * Playground — original Webflow markup (styles/pages/experiment.css).
 * Every card comes from a project folder whose `group` says where it goes.
 */
import '@/styles/pages/experiment.css';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects, type Project } from '@/lib/projects';
import { projectHref, isExternal } from '@/lib/url';

const playground = await getProjects('playground');
const group = (g: NonNullable<Project['data']['group']>) => playground.filter((p) => p.data.group === g);

const creativity = group('creativity-captain');
const philosophy = group('philosophy-mastermind');
const compiler = group('compiler-conqueror');
const workshop = group('workshop-assistant');
const art = group('artistic-alchemist');

/** Background-image URL for cards that used CSS backgrounds on the old site. */
const bg = async (p: Project) => (await getImage({ src: p.data.cover, width: 900, format: 'webp' })).src;
const creativityBg = await Promise.all(creativity.map(bg));
const philosophyBg = await Promise.all(philosophy.map(bg));

// Creativity Captain: rows of three; the old page alternated these wrapper classes.
const rows: { p: Project; img: string }[][] = [];
creativity.forEach((p, i) => {
  if (i % 3 === 0) rows.push([]);
  rows[rows.length - 1]!.push({ p, img: creativityBg[i]! });
});
const imageWrap = ['_3', '_2', ''];
const link = (p: Project) => {
  const url = projectHref(p);
  return { href: url ?? '#', target: isExternal(url) ? '_blank' : undefined, rel: isExternal(url) ? 'noopener' : undefined };
};
---

<BaseLayout title="Playground" description="Experiments in industrial design, code, philosophy and art." background="#f7f8fa">
  <div class="main-feature-wrapper home">
    <div class="text-block-51" data-split="words-slide-up">I also worked as a ......</div>

    <div class="creativity-captain">
      <h2 class="experiment-heading" data-split="words-slide-up">Creativity Captain</h2>
      {rows.map((row, r) => (
        <div class:list={['demo-wrapper', { row3: r > 0 }]} data-reveal={r === 0 ? 'left' : 'bottom'}>
          {row.map(({ p, img }, i) => (
            <div class:list={['d-128-3d-card-wrapper', { row2: r > 0 }]} data-hover="flip">
              <div class:list={['d-128-image-wrapper', imageWrap[i]]}>
                <div class="d-128-image" data-hover-push style={`background-image: url(${img})`}></div>
              </div>
              <div class="d-128-content-wrapper" data-hover-target>
                <h3 class="d-128-h3-card-heading">{p.data.title}</h3>
                <div class="d-128-author-text">{p.data.summary}</div>
                <a class="d-128-button w-button" {...link(p)}>VIEW</a>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <div class="philo-master">
      <h2 class="experiment-heading" data-split="words-slide-up">Philosophy Mastermind</h2>
      <div class="_02-hover" data-reveal="left">
        <div class="d-8-image-wrapper">
          {philosophy.map((p, i) => {
            const url = projectHref(p);
            return (
              <div class="d-8-image" style={`background-image: url(${philosophyBg[i]})`} data-hover="reveal">
                {url ? (
                  <a class="link-block-11 w-inline-block" href={url} target={isExternal(url) ? '_blank' : undefined}>
                    <div class="d-8-image-text" data-hover-target>{p.data.title}</div>
                  </a>
                ) : (
                  <div class="d-8-image-text" data-hover-target>{p.data.title}</div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <div class="conqueror">
      <h2 class="experiment-heading" data-split="words-slide-up">Compiler Conqueror</h2>
      <div class="w-layout-layout quick-stack-16 wf-layout-layout">
        {compiler.map((p) => (
          <div class="w-layout-cell">
            <Image src={p.data.cover} alt="" widths={[600, 1100]} sizes="(max-width: 767px) 100vw, 40vw" />
            <div class="content-heading2 other" data-split="words-slide-up">{p.data.title}</div>
          </div>
        ))}
        <div class="w-layout-cell">
          <div class="content-heading2 other" data-split="words-slide-up">And waiting for more...</div>
        </div>
      </div>
    </div>

    {workshop.map((p) => (
      <div class="workshop">
        <h2 class="experiment-heading" data-split="words-slide-up">{p.data.title}</h2>
        <div class="div-block-36">
          {(p.data.gallery ?? [p.data.cover]).map((img, i) => (
            <Image class={i === 0 ? 'image-49' : undefined} src={img} alt="" widths={[400, 800]} sizes="(max-width: 767px) 100vw, 30vw" />
          ))}
        </div>
      </div>
    ))}

    <div class="artistic-alchemist">
      <h2 class="experiment-heading" data-split="words-slide-up">Artistic Alchemist</h2>
      <div class="work_wrapper">
        <div class="work_list" role="list">
          {art.map((p) => (
            <div class="work_item" item-style={p.data.tileSize} role="listitem">
              <Image class="work-image" src={p.data.cover} alt={p.data.title} widths={[400, 800, 1400]} sizes="(max-width: 767px) 100vw, 40vw" />
              <div class="work_content-wrap">
                <div class="work_date-wrap">
                  <div class="work_date-dot"></div>
                  <div class="work_date-text">{p.data.disciplines}</div>
                </div>
                <div class="work_title-wrap">
                  <div class="work_title">{p.data.title}</div>
                  {p.data.summary !== p.data.disciplines && <div class="work_description">{p.data.summary}</div>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* This page's custom code from the old site: split words get a little
     room below them (which also sets the line height). */
  [data-split] .word { overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; transform-origin: bottom; }
  .experiment-heading { margin: 0; }
  .quick-stack-16 { grid-template-columns: 1fr 1fr; }
  .quick-stack-16 img { width: 100%; height: auto; }
  .div-block-36 img { width: 100%; }
  .d-128-button { text-decoration: none; }
  /* Tile sizes from the old page's custom code. */
  @media screen and (min-width: 768px) {
    [item-style='wide'] { grid-column: span 2; grid-row: span 1; }
    [item-style='tall'] { grid-column: span 1; grid-row: span 2; }
    [item-style='super-wide'] { grid-column: span 4; grid-row: span 1; }
    [item-style='regular'] { grid-column: span 1; grid-row: span 1; }
  }
  @media screen and (max-width: 767px) {
    .quick-stack-16 { grid-template-columns: 1fr; }
  }
</style>
