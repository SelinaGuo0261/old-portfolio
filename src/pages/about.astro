---
/** About — original Webflow markup (styles/pages/about.css). Copy lives in src/data/about.ts. */
import '@/styles/pages/about.css';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { about } from '@/data/about';
import { site } from '@/lib/site';
import { href } from '@/lib/url';

const iconClass = ['image-4', 'image-5', 'image-6', 'image-7'];
---

<BaseLayout title="About" description={about.headline} background="#f7f8fa">
  <div class="main-feature-wrapper about-page">
    <div class="about-skills">
      <div class="w-row">
        <div class="w-col w-col-6 w-col-medium-6 w-col-small-small-stack w-col-tiny-tiny-stack">
          <div class="text-block-24" data-split="words-slide-up">Areas of Expertise</div>
          <div class="text-block-23" data-split="words-slide-up">
            {about.skills.map((s, i) => <>{i > 0 && <br />}{s}</>)}
          </div>
        </div>
        <div class="w-col w-col-6 w-col-medium-6 w-col-small-small-stack w-col-tiny-tiny-stack">
          <div class="div-block-10">
            <div class="columns-5 w-row">
              {about.social.map((s, i) => (
                <div class:list={['w-col w-col-2 w-col-small-2 w-col-tiny-2', { 'column-25': i === 0 }]}>
                  <a class="w-inline-block" href={s.url} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
                    <Image class={iconClass[i]} src={s.icon} alt={s.label} />
                  </a>
                </div>
              ))}
              <div class="w-col w-col-2 w-col-small-2 w-col-tiny-2"></div>
              <div class="w-col w-col-2 w-col-small-2 w-col-tiny-2"></div>
            </div>
          </div>
          <div class="columns-4 w-row">
            <div class="w-col w-col-6">
              <div class="text-block-28" data-split="words-slide-up">Email</div>
              <div class="text-block-26" data-split="words-slide-up"><a href={`mailto:${site.email}`}>{site.email}</a></div>
            </div>
            <div class="w-col w-col-6">
              <div class="text-block-27" data-split="words-slide-up">Phone</div>
              <div class="text-block-25" data-split="words-slide-up"><a href={`tel:${site.phone}`}>{about.phoneDisplay}</a></div>
            </div>
          </div>
          <a class="link-block-2 w-inline-block" href={href(about.resume)} target="_blank" rel="noopener">
            <div class="div-block-9"><div class="text-block-30">Resume</div></div>
          </a>
        </div>
      </div>
    </div>

    <div class="center-text">
      <div class="text-block-29" data-reveal="bottom">
        {about.intro.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </div>
    </div>

    <div class="columns-3 w-row">
      <div class="column-7 w-col w-col-6">
        <Image class="image-137" src={about.portrait} alt="Selina Guo" widths={[480, 960]} sizes="(max-width: 767px) 100vw, 45vw" />
      </div>
      <div class="column-6 w-col w-col-6">
        <h1 class="heading-8" data-split="words-slide-up">{about.headline}</h1>
        {about.bio.map((p) => <div class="content dark-text" data-reveal="right">{p}</div>)}
      </div>
    </div>

    <div class="photos w-row" data-reveal="bottom">
      {about.photos.map((col, i) => (
        <div class={`${['column-46', 'column-44', 'column-45'][i]} w-col w-col-4 w-col-medium-4 w-col-small-small-stack w-col-tiny-4`}>
          {col.map((img, j) => (
            <Image class={i === 0 && j === 1 ? 'image-122' : undefined} src={img} alt="" widths={[400, 800]} sizes="(max-width: 767px) 100vw, 30vw" />
          ))}
        </div>
      ))}
    </div>

    <div class="center-text timeline">
      <div class="text-block-29" data-reveal>{about.storyTitle}</div>
      <h2 class="heading-2 center" data-split="words-slide-up">
        {about.storyLead.map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </h2>
    </div>
  </div>

  <div class="section-timeline-2">
    <div class="container-10">
      <div class="timeline_component">
        <div class="timeline_progress"><div class="timeline_progress-bar"></div></div>
        {about.timeline.map((e) => (
          <div class="timeline_item" data-timeline-item>
            <div class="timeline_left" data-timeline-side><div class="timeline_date-text">{e.date}</div></div>
            <div class="timeline_centre"><div class="timeline_circle" data-timeline-dot></div></div>
            <div class="timeline_right" data-timeline-side>
              <div class={`margin-bottom-${e.gap}`}>
                <div class="timeline_text">
                  {e.text.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}
                </div>
              </div>
              {e.note && (
                <div class="margin-bottom-xlarge">
                  <p class="text-colour-lightgrey">{e.note.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
                </div>
              )}
              {e.image && (
                <div class="timeline_image-wrapper">
                  <Image src={e.image} alt="" widths={[480, 960]} sizes="(max-width: 767px) 100vw, 40vw" />
                </div>
              )}
            </div>
          </div>
        ))}
        <div class="overlay-fade-bottom"></div>
        <div class="overlay-fade-top"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* This page's custom code from the old site. */
  [data-split] .word { overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; transform-origin: bottom; }
  .text-block-26 a, .text-block-25 a { color: inherit; text-decoration: none; }
  .timeline_image-wrapper img { display: block; width: 100%; height: auto; }
  body { margin-bottom: 60px; }
</style>
