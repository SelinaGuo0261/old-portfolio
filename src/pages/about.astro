---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { about } from '@/data/about';
import { site } from '@/lib/site';
import { href } from '@/lib/url';

const contacts = [
  { label: 'LinkedIn', url: site.linkedin },
  { label: 'Instagram', url: site.instagram },
  { label: 'YouTube', url: site.youtube },
  { label: 'GitHub', url: 'https://github.com/SelinaGuo0261' },
];
const phonePretty = '+1 401-537-0517';
---

<BaseLayout title="About" description={about.headline}>
  <div class="about wrap">
    <section class="about__top">
      <div class="about__skills" data-reveal="left">
        <p class="about__eyebrow">Areas of Expertise</p>
        <ul class="about__skill-list">
          {about.skills.map((s) => <li data-split="words-slide-up">{s}</li>)}
        </ul>
      </div>
      <div class="about__contact" data-reveal="right">
        <ul class="about__social">
          {contacts.map((c) => <li><a href={c.url} target="_blank" rel="noopener">{c.label}</a></li>)}
        </ul>
        <dl class="about__details">
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Phone</dt><dd><a href={`tel:${site.phone}`}>{phonePretty}</a></dd></div>
        </dl>
        <a class="about__resume" href={href(about.resume)} target="_blank" rel="noopener" data-hover="slide">
          <span class="about__resume-fill" data-hover-target></span>
          <span class="about__resume-text">Resume</span>
        </a>
      </div>
    </section>

    <p class="about__intro" data-reveal>{about.intro}</p>

    <section class="about__bio">
      <Image class="about__portrait" src={about.portrait} alt="Selina Guo" widths={[480, 960]} sizes="(max-width: 767px) 100vw, 45vw" data-reveal="left" />
      <div>
        <h1 class="about__headline" data-split="words-slide-up">{about.headline}</h1>
        {about.bio.map((p) => <p data-reveal>{p}</p>)}
      </div>
    </section>

    <section class="about__photos" data-reveal="bottom">
      {about.photos.map((col) => (
        <div class="about__photo-col">
          {col.map((img) => <Image src={img} alt="" widths={[400, 800]} sizes="(max-width: 767px) 100vw, 30vw" />)}
        </div>
      ))}
    </section>

    <section class="about__story">
      <p class="about__eyebrow about__eyebrow--center" data-reveal>{about.storyTitle}</p>
      <h2 class="about__story-lead">
        {about.storyLead.map((line) => <span data-split="words-slide-up">{line}</span>)}
      </h2>
    </section>
  </div>

  <section class="timeline">
    <div class="timeline__line" aria-hidden="true"><div class="timeline__progress" data-timeline-progress></div></div>
    {about.timeline.map((e) => (
      <article class="timeline__item" data-timeline-item>
        <div class="timeline__date" data-timeline-side>{e.date}</div>
        <div class="timeline__dot" data-timeline-dot></div>
        <div class="timeline__body" data-timeline-side>
          <p class="timeline__text">{e.text}</p>
          {e.note && <p class="timeline__note">{e.note}</p>}
          {e.image && <Image class="timeline__image" src={e.image} alt="" widths={[480, 960]} sizes="(max-width: 767px) 100vw, 40vw" />}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<script>
  import { gsap } from '@/scripts/gsap';
  // The vertical line fills as you scroll through the timeline.
  const bar = document.querySelector('[data-timeline-progress]');
  if (bar) {
    gsap.fromTo(bar, { scaleY: 0 }, {
      scaleY: 1, ease: 'none',
      scrollTrigger: { trigger: '.timeline', start: 'top center', end: 'bottom center', scrub: true },
    });
  }
</script>

<style>
  .about { color: var(--black); }
  .about__top { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; padding-top: 2rem; }
  .about__eyebrow { font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; margin: 0 0 1rem; color: var(--muted); }
  .about__eyebrow--center { text-align: center; }
  .about__skill-list { list-style: none; margin: 0; padding: 0; font-family: var(--font-display); font-size: 3.5rem; font-weight: 800; line-height: 1.15; }
  .about__social { list-style: none; display: flex; flex-wrap: wrap; gap: 1rem; padding: 0; margin: 0 0 2rem; }
  .about__social a { font-family: var(--font-display); font-weight: 500; text-decoration: none; border-bottom: 2px solid var(--orange); }
  .about__details { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 0 0 2rem; }
  .about__details dt { color: var(--muted); font-size: 0.875rem; }
  .about__details dd { margin: 0; font-weight: 500; }
  .about__details a { text-decoration: none; }
  .about__resume {
    position: relative; display: inline-block; overflow: hidden; isolation: isolate;
    padding: 0.9em 3em; border: 2px solid var(--black); border-radius: 100px;
    font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-decoration: none;
  }
  .about__resume-fill { position: absolute; inset: 0; z-index: -1; background: var(--orange); }
  .about__intro { white-space: pre-line; text-align: center; font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; margin: 6rem 0 4rem; }

  .about__bio { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .about__portrait { width: 100%; height: auto; border-radius: var(--radius); }
  .about__headline { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.2; margin-bottom: 1.5rem; }
  .about__bio p { font-size: 1rem; line-height: 1.7; }

  .about__photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-block: 5rem; }
  .about__photo-col { display: flex; flex-direction: column; gap: 1rem; }
  .about__photo-col img { width: 100%; height: auto; border-radius: var(--radius); }

  .about__story { text-align: center; margin-top: 4rem; }
  .about__story-lead { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.3; }
  .about__story-lead span { display: block; }

  .timeline { position: relative; margin-inline: var(--gutter); padding-block: 4rem 6rem; }
  .timeline__line { position: absolute; left: 30%; top: 0; bottom: 0; width: 3px; margin-left: -1.5px; background: #d9d9d9; }
  .timeline__progress { position: absolute; inset: 0; background: var(--black); transform-origin: top; }
  .timeline__item { position: relative; display: grid; grid-template-columns: 30% 1fr; padding-block: 3rem; }
  .timeline__date { padding-right: 3rem; text-align: right; font-family: var(--font-display); font-size: 2rem; font-weight: 700; line-height: 1.2; position: sticky; top: 40vh; align-self: start; }
  .timeline__dot { position: absolute; left: 30%; top: 3.5rem; width: 18px; height: 18px; margin-left: -9px; border-radius: 50%; background: #414141; box-shadow: 0 0 0 8px var(--paper); }
  .timeline__body { padding-left: 3rem; }
  .timeline__text { white-space: pre-line; font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; line-height: 1.4; margin-top: 0; }
  .timeline__note { white-space: pre-line; color: #5f5f5f; }
  .timeline__image { width: 100%; height: auto; max-width: 36rem; border-radius: var(--radius); margin-top: 1.5rem; }

  @media (max-width: 767px) {
    .about__top, .about__bio { grid-template-columns: 1fr; }
    .about__skill-list { font-size: 2.5rem; }
    .about__photos { grid-template-columns: 1fr; }
    .timeline__line, .timeline__dot { left: 0; }
    .timeline__item { grid-template-columns: 1fr; padding-left: 1.5rem; }
    .timeline__date { position: static; text-align: left; padding: 0 0 1rem; font-size: 1.5rem; }
    .timeline__body { padding-left: 0; }
  }
</style>
