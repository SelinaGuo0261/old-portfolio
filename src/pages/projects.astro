---
/** Case Study — original Webflow markup (styles/pages/projects.css) with a GSAP card stack. */
import '@/styles/pages/projects.css';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/projects';
import { projectHref, isExternal } from '@/lib/url';

const studies = await getProjects('case-study');
const cards = await Promise.all(
  studies.map(async (p) => (await getImage({ src: p.data.card ?? p.data.cover, width: 1200, format: 'webp' })).src),
);
const arrow = 'M10 0.977539L2 8.97754L10 16.9775';
---

<BaseLayout title="Case Study" description="UX and product design case studies." background="#f7f8fa">
  <div class="slidepage">
    <div class="pagecenter">
      <div class="slider-wrap" data-stack tabindex="0" aria-roledescription="carousel" aria-label="Case studies">
        <div class="slider-photo">
          <div class="swiper is-photos">
            <div class="swiper-wrapper is-photos" data-stack-deck role="list">
              {studies.map((p, i) => (
                <div class="swiper-slide is-photos" data-stack-card role="listitem" style={`background-image: url(${cards[i]})`} aria-label={p.data.title}>
                  <div class="slider-height"></div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="slider-content">
          <div class="swiper is-content">
            <div class="swiper-wrapper is-content">
              {studies.map((p, i) => {
                const url = projectHref(p);
                return (
                  <div class="swiper-slide is-content" data-stack-panel hidden={i !== 0}>
                    {p.data.disciplines && <div class="slider-type">{p.data.disciplines}</div>}
                    <h2 class="slider-name" style={p.data.color ? `color: ${p.data.color}` : undefined}>{p.data.title}</h2>
                    <div class="text-block-48">{p.data.description ?? p.data.summary}</div>
                    {p.data.period && <div class="text-block-49">{p.data.period}</div>}
                    <a class="project-btn w-inline-block" href={url} target={isExternal(url) ? '_blank' : undefined} rel={isExternal(url) ? 'noopener' : undefined} data-hover="slide">
                      <div class="demo-btn-wrapper-block f-2" data-hover-target></div>
                      <div class="demo-btn-text">View Project</div>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
          <div class="arrows-2">
            <button type="button" class="arrow is-left" data-stack-prev aria-label="Previous case study">
              <div class="arrow_svg"><svg width="100%" height="100%" viewBox="0 0 11 18" fill="none"><path d={arrow} stroke="currentColor" stroke-width="1.5" /></svg></div>
            </button>
            <button type="button" class="arrow is-right" data-stack-next aria-label="Next case study">
              <div class="arrow_svg is-alt"><svg width="100%" height="100%" viewBox="0 0 11 18" fill="none"><path d={arrow} stroke="currentColor" stroke-width="1.5" /></svg></div>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="customizecursor" data-cursor aria-hidden="true"></div>
</BaseLayout>

<script>
  import { initCardStacks } from '@/scripts/interactions/cardStack';
  import { initCursor } from '@/scripts/interactions/cursor';
  initCardStacks();
  initCursor();
</script>

<style is:global>
  /* Card deck: all cards share one spot; GSAP fans them out. */
  .swiper-wrapper.is-photos { display: grid; perspective: 1200px; transform-style: preserve-3d; cursor: grab; touch-action: pan-y; }
  .swiper-slide.is-photos { grid-area: 1 / 1; transform-origin: 50% 100%; box-shadow: 0 8px 24px #0001; }
  .swiper-slide.is-content[hidden] { display: none; }
  .slider-name { margin: 0; }
  .arrow { background: none; padding: 0; cursor: pointer; color: inherit; font: inherit; }
  .project-btn { overflow: hidden; }
  /* Copyright sits at the bottom of the screen, like the old page's .rights block. */
  .rights-served { position: absolute; inset: auto 0 1%; }
  body { position: relative; height: 100vh; max-height: 100vh; }
  /* The page is exactly one screen tall, nav included. */
  .slidepage { height: calc(100svh - var(--nav-h)); }
  .slidepage + .customizecursor { position: fixed; left: 0; top: 0; pointer-events: none; }
  .customizecursor {
    z-index: 9999;
    width: 40px;
    height: 40px;
    background: url('../assets/site/cursor-gradient.png') center / 40px 40px no-repeat;
  }
</style>
