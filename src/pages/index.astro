---
/**
 * Home page. Markup and class names follow the original Webflow page so
 * the generated stylesheet (styles/pages/index.css) applies unchanged.
 * Lists are generated from src/content/projects.
 */
import '@/styles/pages/index.css';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/projects';
import { href, projectHref, isExternal } from '@/lib/url';
import { home } from '@/data/home';
import { site } from '@/lib/site';
import heroBg from '@/assets/home/hero-bg.png';
import quotation from '@/assets/site/quotation.png';
import star from '@/assets/site/orange-star.svg';
import labelAmazing from '@/assets/site/label-amazing.svg';
import labelDedicated from '@/assets/site/label-dedicated.svg';
import labelPassionate from '@/assets/site/label-passionate.svg';
import labelRemarkable from '@/assets/site/label-remarkable.svg';
import scrollDown from '@/assets/lottie/scroll-down.json?url';
import type { TagSprite } from '@/scripts/interactions/tagPhysics';
import StatusRow from '@/components/legacy/StatusRow.astro';
import WorkRows from '@/components/legacy/WorkRows.astro';

// Pill images for the falling tags, at their natural size (px).
const tagFiles = import.meta.glob<{ default: ImageMetadata }>('@/assets/home/tags/*.svg', { eager: true });
const tagOrder = ['uiux', 'wordpress', 'webflow', 'whitelevel', 'webflow-green', 'sass', 'web', 'startup',
  'maintence', 'integration', 'motion', 'pay', 'gsap', 'figma', 'migration'];
const tags: TagSprite[] = tagOrder.flatMap((name) => {
  const mod = Object.entries(tagFiles).find(([p]) => p.endsWith(`/${name}.svg`))?.[1];
  return mod ? [{ src: mod.default.src, width: mod.default.width, height: mod.default.height }] : [];
});

const all = await getProjects();
const featured = all.filter((p) => p.data.featured);
const showcase = all
  .filter((p) => p.data.showcase)
  .sort((a, b) => (a.data.showcase?.order ?? 0) - (b.data.showcase?.order ?? 0));
const target = (url?: string) => (isExternal(url) ? '_blank' : undefined);
const star4 = 'M16.5 0C16.5 0 16.3243 9.25397 20.0352 12.9648C23.746 16.6757 33 16.5 33 16.5C33 16.5 23.746 16.3243 20.0352 20.0352C16.3243 23.746 16.5 33 16.5 33C16.5 33 16.6757 23.746 12.9648 20.0352C9.25397 16.3243 0 16.5 0 16.5C0 16.5 9.25397 16.6757 12.9648 12.9648C16.6757 9.25397 16.5 0 16.5 0Z';
---

<BaseLayout navVariant="overlay" fullFooter background="#f8f7fa">
  <div class="page-wrapper-4">
    <div class="main-wrapper-2">
      <section class="section-page-intro">
        <div class="page-intro-wrapper">
          <section class="section-3" data-nav-hero>
            <div class="tag-wrapper-2" style={`background-image: url(${heroBg.src})`}>
              <div class="tag-line-wrapper" aria-hidden="true">
                <div class="tag-line-1"></div>
                <div class="tag-line-2"></div>
                <div class="tag-line-3"></div>
                <div class="tag-line-4"></div>
              </div>
              <div class="tag-element-2">
                <div class="tag-vector-wrapper" aria-hidden="true">
                  {[1, 2, 3, 4].map((n) => (
                    <div class={`tag-vector-${n}`} data-hero-star>
                      <svg width="33" height="33" viewBox="0 0 33 33" fill="none"><path d={star4} fill="#BDFE00" /></svg>
                    </div>
                  ))}
                </div>
                <div class="tag-canvas" data-tags={JSON.stringify(tags)}></div>
                <div class="tag-content-wrapper">
                  <div class="div-block-6 home2">
                    <div class="text-block-11 home2" data-split="words-slide-up">{home.greeting}</div>
                    <h1 class="text-block-10 home2">
                      <span class="visually-hidden">{site.fullName}</span>
                      <span class="text-span-3 typer home2" data-typer={JSON.stringify(home.typed)} aria-hidden="true">{home.typed[0]?.word}</span><span class="cursor" aria-hidden="true">_</span>
                    </h1>
                    <div class="headline home2">
                      I am a<span class="text-span home2"> 🚀Creative Technologist</span> and <span class="text-span-2 home2">Product designer</span>, leveraging detail-oriented visual sense and metric-driven problem solving to humanize design and drive measurable impact.
                    </div>
                    <div class="headline home2">
                      💼 Previous worked @ <a class="link-7 home2" href="https://idea.xiaohongshu.com/login" target="_blank" rel="noopener">Xiaohongshu</a>{' '}@ <a class="link-2 home2" href="https://www.alibabagroup.com/en-US" target="_blank" rel="noopener">Alibaba</a>
                    </div>
                    <div class="headline home2">
                      🎓 BFA-ID @ <a class="link-5 home2" href="https://www.risd.edu/academics/industrial-design" target="_blank" rel="noopener">RISD</a>{' '}丨MS-HCDE @ <a class="link-6 home2" href="https://www.hcde.washington.edu/ms" target="_blank" rel="noopener">UW</a>
                    </div>
                  </div>
                </div>
              </div>
              <div class="scroll-lottiw" aria-hidden="true">
                <div class="lottie-animation-6" data-lottie={scrollDown} data-lottie-loop></div>
              </div>
            </div>
          </section>
        </div>

        <div class="section-after-intro-text">
          <div class="main-feature-wrapper home">
            <div class="project-intro">
              <div class="text-block-69" data-split="words-slide-up">{home.intro}</div>
              <StatusRow />
              <h2 class="experiment-heading" data-split="words-slide-up">Latest Works</h2>
            </div>

            <WorkRows projects={featured} />

            <div class="project-showcases">
              <div class="showcase-title-wrapper" data-reveal>
                <div class="showcase-tile"><div class="text-block-69">More interesting...</div></div>
                <div class="showcase-link-wrapper">
                  <a class="link-block-14 w-inline-block" href={href('projects')}><div class="text-block-69">Academic projects</div></a>
                  <a class="link-block-14 w-inline-block" href={href('experiment')}><div class="text-block-69">Playground</div></a>
                </div>
              </div>
              <div class="w-layout-layout quick-stack-22 wf-layout-layout" data-reveal>
                {showcase.map((p) => {
                  const s = p.data.showcase!;
                  const url = projectHref(p) ?? '#';
                  return (
                    <div class="w-layout-cell">
                      <a class="shocase-photolink w-inline-block" href={url} target={target(url)}>
                        <Image class="showcase-photo" src={s.image ?? p.data.cover} alt="" widths={[400, 700]} sizes="(max-width: 991px) 100vw, 22vw" />
                      </a>
                      <h3 class="heading-2 workpage">{s.title ?? p.data.title}</h3>
                      <div class="work-disctription showcase">{s.summary ?? p.data.summary}</div>
                      <div class="work-tag-wrapper">{s.tags.map((t) => <div class="work-tag">{t}</div>)}</div>
                    </div>
                  );
                })}
              </div>
            </div>

            <div class="cover-letter">
              <h2 class="experiment-heading" data-split="words-slide-up">Mentor &amp; Leader kudos</h2>
              {home.kudos.map((k, i) => (
                <div class:list={['cover-letter-1', { letter2: i === 1, letter3: i === 2 }]} data-reveal="fade">
                  <Image class="image-125" src={quotation} alt="" />
                  <div class="text-block-69">" {k.quote} "</div>
                  <div class="recommender-wrapper">
                    <Image class="image-124" src={k.photo} alt="" />
                    <div class="recommender-title">
                      <div class="text-block-69">{k.name}</div>
                      <div class="work-disctription showcase">{k.role}</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <section class="section-5 is--bigger">
              <div class="container-11 flex-v">
                <div class="auto">
                  {home.cta.lines.map((line, i) => (
                    <div class:list={['div-hide', { 'hanging-text': i === 1 }]}>
                      <h2 class="heading-3" data-reveal="heading" data-reveal-delay={String(i * 0.1)}>{line}</h2>
                    </div>
                  ))}
                  <div class="spacer-1em"></div>
                  <p class="paragraph-2" data-reveal="fade">{home.cta.text}</p>
                  <div class="spacer-2em"></div>
                  <div class="btn-wrapper">
                    <a class="btn-2 secondary stagger-text w-inline-block" href={href('about')} data-transition>
                      <div class="btn-text-2">{home.cta.button}</div>
                    </a>
                  </div>
                  <Image class="h-about-star _2" src={star} alt="" data-float data-float-delay="0.2" />
                  <Image class="h-about-star" src={star} alt="" data-float />
                  <Image class="h-about-star _4" src={star} alt="" data-float data-float-delay="0.2" />
                  <Image class="h-about-star _3" src={star} alt="" data-float />
                </div>
              </div>
              <div class="label-1-wrapper"><Image class="label-1 is--h-about" src={labelAmazing} alt="Amazing" data-reveal="left" /></div>
              <div class="label-2-wrapper"><Image class="label-2 is--h-about" src={labelDedicated} alt="Dedicated" data-reveal="drop" /></div>
              <div class="label-3-wrapper"><Image class="label-3 is--h-about" src={labelPassionate} alt="Passionate" data-reveal="right" /></div>
              <div class="label-4-wrapper"><Image class="label-4 is--h-about" src={labelRemarkable} alt="Remarkable" data-reveal="grow" /></div>
            </section>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { gsap, ScrollTrigger } from '@/scripts/gsap';
  import { initTagPhysics, type TagSprite } from '@/scripts/interactions/tagPhysics';
  import { initTypers } from '@/scripts/interactions/typer';
  import { initPageTransitions } from '@/scripts/interactions/pageTransition';

  const tagBox = document.querySelector<HTMLElement>('[data-tags]');
  if (tagBox) initTagPhysics(tagBox, JSON.parse(tagBox.dataset.tags ?? '[]') as TagSprite[]);
  initTypers();
  initPageTransitions();

  // Corner stars flip once when the hero comes into view (old "rotate animation").
  ScrollTrigger.create({
    trigger: '[data-nav-hero]',
    start: 'top 80%',
    once: true,
    onEnter: () => {
      gsap.timeline()
        .to('[data-hero-star]', { rotationY: 180, duration: 1, ease: 'power1.in' })
        .to('[data-hero-star]', { rotationY: 0, duration: 1, ease: 'power1.in' });
    },
  });
</script>

<style is:global>
  /* Grid layout of the showcase stack (Webflow stored this on an element id). */
  .quick-stack-22 { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: auto; padding: 0; }
  @media screen and (max-width: 991px) { .quick-stack-22 { grid-template-columns: 1fr 1fr; } }
  @media screen and (max-width: 479px) { .quick-stack-22 { grid-template-columns: 1fr; } }
  .work-title { margin: 0; }
  .text-block-10.home2 { margin: 0; }
  .experiment-heading { margin: 0; }
  .heading-2.workpage { font-weight: 500; }
  .heading-3 { font-weight: 500; }
  .btn-text-2 { font-weight: 400; color: #040915; }
  .tag-canvas canvas { display: block; }
  .tag-content-wrapper { pointer-events: none; }
  .tag-content-wrapper a { pointer-events: auto; }
  .work-link { text-decoration: none; }
  .work-link-icon { width: 100%; height: auto; }
</style>
